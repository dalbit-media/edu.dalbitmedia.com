PUBLIC_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=8787
# Optional first-admin seed (16-256 characters); stored as a salted hash only on an empty admin database.
# Leave blank to choose a password in the local /admin setup screen. Never use VITE_ for secrets.
ADMIN_PASSWORD=
# For remote first-admin setup only: a random secret of 32-256 characters. Remove after setup.
# Public setup stays locked without this secret. Local loopback setup needs no token.
ADMIN_SETUP_TOKEN=
SUPPORT_EMAIL=
# Toss API individual-integration keys (not payment-widget keys). Start with matching test keys.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# Optional: an absolute path on a persistent disk. Default: data/dalbit.sqlite
DATABASE_PATH=
